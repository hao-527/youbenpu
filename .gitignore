# Dependencies and build output
node_modules/
dist/
apps/*/dist/
apps/*/dist-h5/
coverage/

# Generated caches and host-specific build helpers
**/.swc/
**/__pycache__/
*.py[cod]
services/api/api

# Environment and local configuration
.env
.env.*
!.env.example
**/project.private.config.json

# Local uploads (Tencent COS adapter will replace this in production)
services/api/data/uploads/*
!services/api/data/uploads/.gitkeep

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp

# AI-generated artifacts (not source code)
design-system/
semantic-review/
demos/

# Logs
*.log
npm-debug.log*

# Local-only private docs (server access notes, credentials, etc.) — never commit
*.local.md
**/*.local.md

# IDE / Agent 工作目录
.kiro/

# 备份文件
*.bak

# Real personal bill statements (WeChat/Alipay) used only for local dev/testing.
# These contain real transactions and must never be committed.
bills/
**/billimport/testdata/*.csv
**/billimport/testdata/*.xlsx

# Local immutable release artifacts (never source or private config)
/releases/

# Design review artifacts (screenshots, baselines, reports); large, kept locally only
design/
