APP_ENV=development
HTTP_ADDRESS=:8080
# local for filesystem development; cos for Tencent COS-backed uploads.
OBJECT_STORE=local
UPLOAD_DIR=./data/uploads
SHUTDOWN_TIMEOUT=10s

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=youbenpu

# WeChat Mini Program. Leave both empty only for local dev-identity login.
WX_APPID=your_wechat_app_id
WX_APP_SECRET=your_wechat_app_secret

# Production requires a random secret of at least 32 bytes.
# Example generator: openssl rand -base64 48
JWT_SECRET=youbenpu-dev-secret-change-me

# Tencent COS (for image upload)
COS_BUCKET=shenghuoyoubenpu-1410259056
COS_REGION=ap-beijing
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
